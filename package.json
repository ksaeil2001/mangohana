{
  "name": "trio-manga-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:web": "vite build --watch --config apps/web/vite.config.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "contracts:generate": "tsx scripts/generate-contracts.ts",
    "config:check": "tsx scripts/check-config.ts",
    "measure:owned": "tsx scripts/measure-owned.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:domain": "vitest run tests/domain",
    "test:postgres": "tsx scripts/test-postgres.ts",
    "test:protocol": "tsx scripts/test-postgres.ts tests/postgres/protocol.test.ts",
    "test:browser": "tsx scripts/test-browser.ts",
    "test": "tsx scripts/test-all.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0",
    "decimal.js": "10.6.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.1.0",
    "json-schema-to-typescript": "16.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
